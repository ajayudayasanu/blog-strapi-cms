runtime: nodejs22
instance_class: F2

automatic_scaling:
  min_instances: 1
  max_instances: 1
  target_cpu_utilization: 0.65

env_variables:
  HOST: '0.0.0.0'
  PORT: '8080'
  NODE_ENV: 'production'

  # Strapi secrets (filled in by Cloud Build from Secret Manager)
  APP_KEYS: '__APP_KEYS__'
  API_TOKEN_SALT: '__API_TOKEN_SALT__'
  ADMIN_JWT_SECRET: '__ADMIN_JWT_SECRET__'
  TRANSFER_TOKEN_SALT: '__TRANSFER_TOKEN_SALT__'
  ENCRYPTION_KEY: '__ENCRYPTION_KEY__'
  JWT_SECRET: '__JWT_SECRET__'

  # Database
  DATABASE_CLIENT: 'postgres'
  DATABASE_NAME: 'postgres'
  DATABASE_USERNAME: 'postgres'
  DATABASE_PASSWORD: '__DATABASE_PASSWORD__'
  DATABASE_HOST: '/cloudsql/strapi-cms-505607:us-central1:strapi-sql'
  DATABASE_PORT: '5432'
  DATABASE_SSL: 'false'
  INSTANCE_CONNECTION_NAME: 'strapi-cms-505607:us-central1:strapi-sql'

  # GCS
  GCS_BUCKET_NAME: 'strapi-cms-storage-bucket'
  GCS_BASE_PATH: 'cms'

vpc_access_connector:
  name: projects/strapi-cms-505607/locations/us-central1/connectors/strapi-connector

beta_settings:
  cloud_sql_instances: 'strapi-cms-505607:us-central1:strapi-sql'

handlers:
  - url: /.*
    script: auto
    secure: always
